{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simulator-misclib",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding. The service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "simulator-misclib"
    }
  ],
  // カスタムドメイン。Cloudflare 上に misclib.com のゾーンがあれば
  // デプロイ時に DNS レコードと証明書が自動で作られる。
  "routes": [
    {
      "pattern": "simu.misclib.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
